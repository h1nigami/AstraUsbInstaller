<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AstraUsb.ViewModels"
        xmlns:svc="clr-namespace:AstraUsb.Services"
        x:Class="AstraUsb.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BestCam USB Backup Manager"
        Width="800" Height="600"
        WindowState="FullScreen"
        SystemDecorations="None"
        Background="{StaticResource BgAppBrush}"
        FontFamily="{StaticResource FontBody}">

  <Window.Styles>
    <!-- Окно отсека. Обводка, фон и полоса приходят из модели: состояние
         кодируется ими одновременно, а не одним цветом. -->
    <Style Selector="Border.bay">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.3" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Полоса растёт плавно, а не рывком на каждый отчёт о ходе выгрузки. -->
    <Style Selector="Border.fill">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.45" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="62,Auto,*,30" Background="{StaticResource BgAppBrush}">

    <!-- Шапка: марка, название станции, часы, выход -->
    <Grid Grid.Row="0" Background="{StaticResource BgPanelBrush}"
          ColumnDefinitions="Auto,Auto,*,Auto,Auto">

      <Border Grid.Column="0" Width="34" Height="34" Margin="12,0,10,0"
              CornerRadius="17" VerticalAlignment="Center"
              Background="{StaticResource AccentBrush}">
        <TextBlock Text="BC" FontFamily="{StaticResource FontHeading}"
                   FontWeight="ExtraBold" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource FgOnDarkBrush}" />
      </Border>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="BestCam BC-10" Classes="h2" FontSize="17" />
        <TextBlock Text="ТЕРМИНАЛ СБОРА И ХРАНЕНИЯ ДАННЫХ" Classes="label" />
      </StackPanel>

      <Border Grid.Column="3" Margin="0,0,10,0" Padding="12,4" CornerRadius="20"
              VerticalAlignment="Center" Background="{StaticResource BgAppBrush}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding ClockTime}" Classes="mono"
                     FontSize="19" FontWeight="Bold" VerticalAlignment="Center"
                     Foreground="{StaticResource FgMainBrush}" />
          <TextBlock Text="{Binding ClockDate}" FontSize="10" VerticalAlignment="Bottom"
                     Margin="0,0,0,3" Foreground="{StaticResource FgMutedBrush}" />
        </StackPanel>
      </Border>

      <Button Grid.Column="4" Classes="danger" Content="Выход" Margin="0,0,12,0"
              Height="40" Padding="18,0" VerticalAlignment="Center"
              Command="{Binding ExitCommand}" />
    </Grid>

    <!-- Строка состояния служб: по заданию она видна всегда -->
    <Grid Grid.Row="1" Background="{StaticResource BgPanelBrush}"
          ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,1">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                  Margin="12,0,0,8" VerticalAlignment="Center">
        <Border Padding="10,4" CornerRadius="14" Background="{StaticResource Teal100Brush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource Teal500Brush}" />
            <TextBlock Text="Монитор USB активен" FontSize="10"
                       Foreground="{StaticResource Teal900Brush}" />
          </StackPanel>
        </Border>
        <Border Padding="10,4" CornerRadius="14" Background="{StaticResource Neutral200Brush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource Neutral500Brush}" />
            <TextBlock Text="Локальная база" FontSize="10"
                       Foreground="{StaticResource FgMutedBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" Margin="0,0,12,8"
                 VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}" />
    </Grid>

    <TabControl x:Name="Tabs" Grid.Row="2" Padding="0" Background="Transparent">

      <TabItem Header="СБОР ДАННЫХ">
        <Grid RowDefinitions="Auto,*" Margin="10,8">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,6">
            <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
              <TextBlock Text="Сбор данных" Classes="h1" FontSize="22" LineHeight="26" />
              <TextBlock Classes="hint" MaxWidth="420" FontSize="10"
                         Text="Забирать регистратор можно, когда окно стало бирюзовым" />
            </StackPanel>

            <Border Grid.Column="1" Padding="4" CornerRadius="20" VerticalAlignment="Center"
                    Background="{StaticResource Neutral200Brush}">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="Сетка" Height="36" Padding="14,0" FontSize="12"
                        Classes.primary="{Binding IsGridLayout}"
                        Command="{Binding SetLayoutCommand}" CommandParameter="grid" />
                <Button Content="Список" Height="36" Padding="14,0" FontSize="12"
                        Classes.primary="{Binding IsListLayout}"
                        Command="{Binding SetLayoutCommand}" CommandParameter="list" />
                <Button Content="Схема" Height="36" Padding="14,0" FontSize="12"
                        Classes.primary="{Binding IsRackLayout}"
                        Command="{Binding SetLayoutCommand}" CommandParameter="rack" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Сетка: до двенадцати окон, компоновка по умолчанию -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Ports}"
                        IsVisible="{Binding IsGridLayout}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PortViewModel">
                <Border Classes="bay" Padding="10,8" Background="{Binding Fill}"
                        BorderBrush="{Binding Edge}">
                  <!-- Четыре строки и полоса: больше в окно при высоте
                       станции не влезает, не отняв у состояния его кегль. -->
                  <Grid RowDefinitions="22,*,Auto,3,7">

                    <Grid Grid.Row="0" ColumnDefinitions="22,*">
                      <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                              Background="{Binding Mark}">
                        <TextBlock Text="{Binding SlotLabel}" FontSize="11"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding SlotInk}" />
                      </Border>
                      <TextBlock Grid.Column="1" Margin="7,0,0,0" FontSize="11"
                                 FontWeight="SemiBold" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding EmployeeLine}" Foreground="{Binding Ink}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="{Binding StateText}" Classes="state"
                                 FontSize="17" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Foreground="{Binding Ink}" />
                      <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="mono"
                                 FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                 Foreground="{Binding Ink}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding StateHint}" FontSize="10"
                               TextTrimming="CharacterEllipsis" Foreground="{Binding InkMuted}" />

                    <Border Grid.Row="4" Height="7" CornerRadius="4" ClipToBounds="True"
                            Background="{Binding Track}">
                      <Border Classes="fill" HorizontalAlignment="Left" CornerRadius="4"
                              Width="{Binding BarFill}" Background="{Binding Mark}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Список: строки, когда окон больше двенадцати -->
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsListLayout}">
            <ItemsControl ItemsSource="{Binding Ports}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PortViewModel">
                  <Border Classes="bay" Padding="12,8" Margin="4,3"
                          Background="{Binding Fill}" BorderBrush="{Binding Edge}">
                    <Grid ColumnDefinitions="28,150,110,*,Auto">
                      <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                              Background="{Binding Mark}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SlotLabel}" FontSize="12"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding SlotInk}" />
                      </Border>

                      <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmployeeLine}" FontSize="12"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Ink}" />
                        <TextBlock Text="{Binding DepartmentLine}" FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding InkMuted}" />
                      </StackPanel>

                      <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                 FontFamily="{StaticResource FontHeading}"
                                 FontWeight="ExtraBold" FontSize="13"
                                 VerticalAlignment="Center" Foreground="{Binding Ink}" />

                      <Border Grid.Column="3" Height="7" CornerRadius="4" ClipToBounds="True"
                              VerticalAlignment="Center" Margin="8,0"
                              Background="{Binding Track}">
                        <Border Classes="fill" HorizontalAlignment="Left" CornerRadius="4"
                                Width="{Binding BarFill}" Background="{Binding Mark}" />
                      </Border>

                      <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                  HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PercentText}" Classes="mono" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Right"
                                   Foreground="{Binding Ink}" />
                        <TextBlock Text="{Binding FilesLine}" FontSize="10"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding InkMuted}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Схема стойки: карта отсеков для сверки номеров с железом -->
          <Border Grid.Row="1" Classes="panel" Padding="10" IsVisible="{Binding IsRackLayout}">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Margin="4,2,0,8" Classes="hint"
                         Text="Номера соответствуют физическим отсекам после сопоставления портов" />
              <ItemsControl Grid.Row="1" ItemsSource="{Binding Ports}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="148" ItemHeight="104" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PortViewModel">
                    <Border Classes="bay" Padding="8" Margin="4"
                            Background="{Binding Fill}" BorderBrush="{Binding Edge}">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <!-- Скоба сверху повторяет вид регистратора в отсеке -->
                        <Border Height="5" Width="40" CornerRadius="3"
                                HorizontalAlignment="Center" Background="{Binding Mark}" />
                        <Border Width="26" Height="26" CornerRadius="13"
                                HorizontalAlignment="Center" Background="{Binding Mark}">
                          <TextBlock Text="{Binding SlotLabel}" FontSize="12"
                                     FontFamily="{StaticResource FontHeading}"
                                     FontWeight="ExtraBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{Binding SlotInk}" />
                        </Border>
                        <TextBlock Text="{Binding StateText}" FontSize="11"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontWeight="ExtraBold" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Ink}" />
                        <TextBlock Text="{Binding EmployeeLine}" FontSize="10"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding InkMuted}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="ПОИСК">
        <Grid RowDefinitions="Auto,*,Auto" Margin="10,8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Загружено с" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}" />
            <TextBox Text="{Binding Search.From}" Width="100" />
            <TextBlock Text="по" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}" />
            <TextBox Text="{Binding Search.To}" Width="100" />
            <TextBlock Text="Камера" VerticalAlignment="Center" FontSize="11" Margin="10,0,0,0"
                       Foreground="{StaticResource FgMutedBrush}" />
            <TextBox Text="{Binding Search.Camera}" Width="140" Watermark="номер или имя" />
            <Button Content="Найти" Command="{Binding Search.SearchCommand}" />
            <Button Content="Сброс" Command="{Binding Search.ResetCommand}" />
          </StackPanel>

          <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <ListBox ItemsSource="{Binding Search.Results}"
                     SelectedItem="{Binding Search.Selected}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FoundFile">
                  <Grid ColumnDefinitions="120,*,80,110,110,80" Height="26">
                    <TextBlock Grid.Column="0" Text="{Binding Camera}" FontSize="11"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Accent700Brush}" />
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding CollectedAt}" FontSize="11"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding ShotAt}" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="5" Text="{Binding Mark}" FontSize="11"
                               VerticalAlignment="Center" Foreground="#FFB020" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <StackPanel Grid.Row="2" Spacing="6" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Заметка" VerticalAlignment="Center" FontSize="11"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding Search.NoteInput}" Width="240"
                       Watermark="по какому случаю нужна запись" />
              <Button Content="Сохранить заметку" Command="{Binding Search.SaveNoteCommand}" />
              <Button Content="Защитить или снять"
                      Command="{Binding Search.ToggleImportantCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Выгрузить найденное в" VerticalAlignment="Center" FontSize="11"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding Search.ExportTarget}" Width="300"
                       Watermark="путь к папке или флешке" />
              <Button Content="Выгрузить" Command="{Binding Search.ExportCommand}"
                      IsEnabled="{Binding !Search.Exporting}" />
              <TextBlock FontSize="10" VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}"
                         Text="колонки: камера, файл, размер, загружено в станцию, снято, защита" />
            </StackPanel>
            <TextBlock Text="{Binding Search.Hint}" FontSize="11"
                       Foreground="{StaticResource Accent700Brush}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="УСТРОЙСТВА">
        <Grid RowDefinitions="*,Auto" Margin="10,8">
          <!-- Панель управления прижата к низу и получает место раньше списка:
               на экране 1024x600 иначе она уезжает за край. -->
          <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <Grid RowDefinitions="24,*">
              <Grid Grid.Row="0" ColumnDefinitions="90,160,*,140,120" Margin="10,6,10,0">
                <TextBlock Grid.Column="0" Text="КАМЕРА" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="1" Text="СОТРУДНИК" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="2" Text="ОТДЕЛ" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="3" Text="ПОСЛЕДНЯЯ ЗАГРУЗКА" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="4" Text="НОСИТЕЛЬ" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding Devices.Devices}"
                     SelectedItem="{Binding Devices.Selected}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceRow">
                  <Grid ColumnDefinitions="90,160,*,140,120" Height="30">
                    <TextBlock Grid.Column="0" Text="{Binding Display}"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource Accent700Brush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Employee}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Department}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding LastSeen}"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding Label}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Имя камеры" VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding Devices.NameInput}" Width="200" />
              <Button Content="Переименовать" Command="{Binding Devices.RenameCommand}" />
              <TextBlock Text="Сотрудник" VerticalAlignment="Center" Margin="12,0,0,0"
                         Foreground="{StaticResource FgMutedBrush}" />
              <ComboBox ItemsSource="{Binding Devices.Employees}"
                        SelectedItem="{Binding Devices.EmployeeInput}" Width="190">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:Employee">
                    <TextBlock Text="{Binding FullName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Закрепить" Command="{Binding Devices.AssignCommand}" />
              <Button Content="Обновить" Command="{Binding Devices.ReloadCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Devices.Hint}" FontSize="11"
                       Foreground="{StaticResource Accent700Brush}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="СОТРУДНИКИ">
        <Grid ColumnDefinitions="290,*" RowDefinitions="*,Auto" Margin="10,8">

          <!-- Отделы. Путь показан целиком: вложенность иначе не видна. -->
          <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,0"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <Grid RowDefinitions="24,*">
              <TextBlock Grid.Row="0" Text="ОТДЕЛЫ" Margin="10,6,0,0" FontSize="10"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBlock Grid.Row="1" IsVisible="{Binding Staff.NoDepartments}"
                         Text="Отделов пока нет. Введите название внизу и нажмите «Добавить отдел»."
                         Margin="12,8" TextWrapping="Wrap" FontSize="11"
                         Foreground="{StaticResource FgMutedBrush}" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Staff.Departments}"
                       SelectedItem="{Binding Staff.SelectedDepartment}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DepartmentRow">
                    <TextBlock Text="{Binding Path}" Height="26" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Row="0" Grid.Column="1"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <Grid RowDefinitions="24,*">
              <Grid Grid.Row="0" ColumnDefinitions="110,*,150,80" Margin="10,6,10,0">
                <TextBlock Grid.Column="0" Text="НОМЕР" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="1" Text="ИМЯ" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="2" Text="ТЕЛЕФОН" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding Staff.Employees}"
                     SelectedItem="{Binding Staff.Selected}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="svc:Employee">
                  <Grid ColumnDefinitions="110,*,150,80" Height="28">
                    <TextBlock Grid.Column="0" Text="{Binding PersonnelNo}"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource Accent700Brush}" />
                    <TextBlock Grid.Column="1" Text="{Binding FullName}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Phone}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="уволен" IsVisible="{Binding !Active}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" Margin="0,8,8,0">
            <TextBox Text="{Binding Staff.DepartmentNameInput}" Watermark="Название отдела" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Добавить отдел" Command="{Binding Staff.AddDepartmentCommand}" />
              <Button Content="Удалить" Command="{Binding Staff.DeleteDepartmentCommand}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Номер" VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding Staff.PersonnelNoInput}" Width="100"
                       FontFamily="DejaVu Sans Mono, Consolas, monospace" />
              <TextBlock Text="Имя" VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding Staff.FullNameInput}" Width="190" />
              <TextBlock Text="Телефон" VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding Staff.PhoneInput}" Width="120" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Отдел" VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}" />
              <ComboBox ItemsSource="{Binding Staff.Departments}"
                        SelectedItem="{Binding Staff.DepartmentInput}" Width="200">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DepartmentRow">
                    <TextBlock Text="{Binding Path}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Новый" Command="{Binding Staff.NewEmployeeCommand}" />
              <Button Content="Сохранить" Command="{Binding Staff.SaveEmployeeCommand}" />
              <Button Content="Уволить" Command="{Binding Staff.DeactivateCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Staff.Hint}" FontSize="11"
                       Foreground="{StaticResource Accent700Brush}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="ЖУРНАЛ">
        <Grid RowDefinitions="Auto,*,Auto" Margin="10,8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="События с" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}" />
            <TextBox Text="{Binding Log.From}" Width="100" />
            <TextBlock Text="по" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}" />
            <TextBox Text="{Binding Log.To}" Width="100" />
            <Button Content="Показать" Command="{Binding Log.ReloadCommand}" />
            <Button Content="Сегодня" Command="{Binding Log.TodayCommand}" />
            <Button Content="Неделя" Command="{Binding Log.WeekCommand}" />
          </StackPanel>

          <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <Grid RowDefinitions="24,*">
              <Grid Grid.Row="0" ColumnDefinitions="140,110,*" Margin="10,6,10,0">
                <TextBlock Grid.Column="0" Text="КОГДА" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="1" Text="СОБЫТИЕ" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="2" Text="ЧТО ПРОИЗОШЛО" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding Log.Entries}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogRow">
                    <Grid ColumnDefinitions="140,110,*" Height="24">
                      <TextBlock Grid.Column="0" Text="{Binding At}" FontSize="11"
                                 FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource FgMutedBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource Accent700Brush}" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Foreground="{StaticResource FgMainBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <TextBlock Grid.Row="2" Text="{Binding Log.Hint}" FontSize="11" Margin="0,6,0,0"
                     Foreground="{StaticResource Accent700Brush}" />
        </Grid>
      </TabItem>

      <TabItem Header="НАСТРОЙКИ">
        <ScrollViewer>
          <Grid ColumnDefinitions="*,*" Margin="10,8">

            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,6,0">
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="2" Padding="10" Background="{StaticResource BgPanelBrush}">
                <StackPanel Spacing="6">
                  <TextBlock Text="СТАНЦИЯ И ХРАНИЛИЩЕ" FontSize="11" LetterSpacing="1.6"
                             Foreground="{StaticResource Accent700Brush}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Окон сбора" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}" />
                    <NumericUpDown Value="{Binding Settings.BayCount}" Minimum="6" Maximum="30"
                                   Increment="1" Width="110" FormatString="0" />
                    <Button Content="Сохранить" Command="{Binding Settings.SaveBayCountCommand}" />
                  </StackPanel>
                  <TextBlock IsVisible="{Binding Settings.RestartNeeded}" Classes="hint"
                             Foreground="{StaticResource WarnBrush}"
                             Text="Число окон изменено. Перезапустите программу, чтобы доска перестроилась." />

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Номер станции" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}" />
                    <TextBox Text="{Binding Settings.StationNumber}" Width="60" />
                    <TextBlock FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}"
                               Text="входит в номера камер: BCU-01-0042" />
                  </StackPanel>
                  <TextBlock Text="Папка для копий" FontSize="11"
                             Foreground="{StaticResource FgMutedBrush}" />
                  <TextBox Text="{Binding Settings.BackupRoot}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Оставлять свободными, ГБ" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}" />
                    <TextBox Text="{Binding Settings.MinFreeGb}" Width="70" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Когда место кончается" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}" />
                    <ComboBox ItemsSource="{Binding Settings.StorageModes}"
                              SelectedIndex="{Binding Settings.StorageModeIndex}" Width="190" />
                  </StackPanel>
                  <TextBlock IsVisible="{Binding Settings.ArchiveOnSystemDrive}"
                             Text="Архив лежит на системном разделе. Выберите отдельный диск: системный переполнится записями."
                             FontSize="11" TextWrapping="Wrap" Foreground="#FFB020" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Хранить записи, дней" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}" />
                    <TextBox Text="{Binding Settings.KeepDays}" Width="70" />
                    <TextBlock Text="0 хранит бессрочно" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}" />
                  </StackPanel>
                  <CheckBox Content="Удалять видео с камеры после загрузки"
                            IsChecked="{Binding Settings.DeleteVideoAfterCopy}" />
                  <Button Content="Сохранить" Command="{Binding Settings.SaveStorageCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="2" Padding="10" Background="{StaticResource BgPanelBrush}">
                <StackPanel Spacing="8">
                  <TextBlock Text="ДОСТУП" FontSize="11" LetterSpacing="1.6"
                             Foreground="{StaticResource Accent700Brush}" />
                  <TextBlock Text="Учётной записью администратора закрыты выход из программы и все разделы, кроме сбора данных."
                             FontSize="11" TextWrapping="Wrap"
                             Foreground="{StaticResource FgMutedBrush}" />
                  <TextBlock Text="Пароль ещё не меняли: станция открывается стандартным из задания."
                             IsVisible="{Binding Settings.UsingDefaultPassword}"
                             FontSize="11" TextWrapping="Wrap" Foreground="#FFB020" />

                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Учётная запись" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBox Width="140" Text="{Binding Settings.AdminAccount}" />
                  </StackPanel>

                  <!-- Форма в одну строку: вертикаль на экране станции дороже
                       подписей, и подсказки в самих полях их заменяют. -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Width="112" PasswordChar="●" Watermark="текущий"
                             Text="{Binding Settings.CurrentPassword}" />
                    <TextBox Width="112" PasswordChar="●" Watermark="новый"
                             Text="{Binding Settings.NewPassword}" />
                    <TextBox Width="112" PasswordChar="●" Watermark="повторите"
                             Text="{Binding Settings.RepeatPassword}" />
                    <Button Content="Сменить" Command="{Binding Settings.ChangePasswordCommand}" />
                  </StackPanel>


                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Закрывать разделы через" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource FgMutedBrush}" />
                    <NumericUpDown Value="{Binding Settings.LockTimeoutMinutes}"
                                   Minimum="0" Maximum="240" Increment="5" Width="110"
                                   FormatString="0" />
                    <TextBlock Text="мин простоя" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <Button Content="Сохранить"
                            Command="{Binding Settings.SaveLockTimeoutCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8" Margin="6,0,0,0">
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="2" Padding="10" Background="{StaticResource BgPanelBrush}">
                <StackPanel Spacing="6">
                  <TextBlock Text="РАЗМЕТКА ГНЁЗД" FontSize="11" LetterSpacing="1.6"
                             Foreground="{StaticResource Accent700Brush}" />
                  <TextBlock FontSize="11" TextWrapping="Wrap"
                             Foreground="{StaticResource FgMutedBrush}"
                             Text="Вставьте камеру в размечаемый отсек, оставив её единственной подключённой, и нажмите «Сопоставить» напротив нужного окна." />
                  <ItemsControl ItemsSource="{Binding Settings.Slots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SlotRow">
                        <Grid ColumnDefinitions="70,*,110" Height="26">
                          <TextBlock Grid.Column="0" Text="{Binding SlotLabel}" FontSize="11"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource FgMainBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding PortLabel}" FontSize="11"
                                     FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource FgMutedBrush}" />
                          <Button Grid.Column="2" Content="Сопоставить" FontSize="10"
                                  Padding="8,2"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MapSlotCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Снять разметку"
                          Command="{Binding Settings.ClearSlotsCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="2" Padding="10" Background="{StaticResource BgPanelBrush}">
                <StackPanel Spacing="4">
                  <TextBlock Text="О ПРОГРАММЕ" FontSize="11" LetterSpacing="1.6"
                             Foreground="{StaticResource Accent700Brush}" />
                  <TextBlock Text="BestCam USB Backup Manager" FontSize="12"
                             Foreground="{StaticResource FgMainBrush}" />
                  <TextBlock Text="{Binding Version}" FontSize="11"
                             Foreground="{StaticResource FgMutedBrush}" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding Settings.Hint}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource Accent700Brush}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Нижняя строка: слева марка, по центру заполнение хранилища, справа состояние -->
    <Grid Grid.Row="3" Background="{StaticResource BgPanelBrush}"
          ColumnDefinitions="Auto,*,Auto">
      <Border Grid.Column="0" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top"
              Background="{StaticResource LineBrush}" />
      <TextBlock Grid.Column="0" Text="© BestCam" Margin="12,0" FontSize="10"
                 VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding StorageLabel}" FontSize="10"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource FgMutedBrush}" />
        <Border Width="150" Height="6" CornerRadius="1"
                Background="{StaticResource BgSurfaceBrush}" ClipToBounds="True">
          <Border HorizontalAlignment="Left" Width="{Binding StorageWidth}"
                  Background="{Binding StorageBrush}">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.6" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.4" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Border>
      </StackPanel>

      <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="12,0" FontSize="10"
                 VerticalAlignment="Center" Foreground="{StaticResource Accent700Brush}"
                 />
    </Grid>

    <!-- Запрос пароля. Перекрывает весь экран: в киоске это единственная
         преграда между посторонним и выходом из программы. -->
    <Border Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding PasswordVisible}"
            Background="#E6050A14">
      <Border Width="580" Padding="24" CornerRadius="2"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource Accent700Brush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding PasswordPrompt}" FontSize="15" FontWeight="Bold"
                     Foreground="{StaticResource FgMainBrush}" />
          <TextBlock Text="Введите учётную запись и пароль администратора" FontSize="11"
                     Foreground="{StaticResource FgMutedBrush}" />

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,16,0">
              <TextBlock Text="УЧЁТНАЯ ЗАПИСЬ" FontSize="10"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding AccountInput}" FontSize="15" />

              <TextBlock Text="ПАРОЛЬ" FontSize="10" Margin="0,4,0,0"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox x:Name="PasswordBox" PasswordChar="●" FontSize="16"
                       Text="{Binding PasswordInput}" />

              <TextBlock Text="{Binding PasswordError}" FontSize="11"
                         TextWrapping="Wrap" Foreground="#FF3B5C" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Войти" IsDefault="True" Height="46" Width="120"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ConfirmPasswordCommand}" />
                <Button Content="Отмена" Height="46" Width="120"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CancelPasswordCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Экранная клавиатура: станция сенсорная, физической
                 клавиатуры у неё нет, а пароль по заданию цифровой. -->
            <UniformGrid Grid.Column="1" Columns="3" Rows="4" Width="216">
            <Button Content="1" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="1" />
            <Button Content="2" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="2" />
            <Button Content="3" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="3" />
            <Button Content="4" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="4" />
            <Button Content="5" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="5" />
            <Button Content="6" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="6" />
            <Button Content="7" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="7" />
            <Button Content="8" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="8" />
            <Button Content="9" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="9" />
            <Button Content="C" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="C" />
            <Button Content="0" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="0" />
            <Button Content="←" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="&lt;" />
            </UniformGrid>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
