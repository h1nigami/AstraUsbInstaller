<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AstraUsb.ViewModels"
        xmlns:svc="clr-namespace:AstraUsb.Services"
        x:Class="AstraUsb.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BestCam USB Backup Manager"
        Width="800" Height="600"
        WindowState="FullScreen"
        SystemDecorations="None"
        Background="{StaticResource BgAppBrush}"
        FontFamily="{StaticResource FontBody}">

  <Window.Styles>
    <!-- Окно отсека. Обводка, фон и полоса приходят из модели: состояние
         кодируется ими одновременно, а не одним цветом. -->
    <Style Selector="Border.bay">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.3" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Полоса растёт плавно, а не рывком на каждый отчёт о ходе выгрузки. -->
    <Style Selector="Border.fill">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.45" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="62,Auto,*,30" Background="{StaticResource BgAppBrush}">

    <!-- Шапка: марка, название станции, часы, выход -->
    <Grid Grid.Row="0" Background="{StaticResource BgPanelBrush}"
          ColumnDefinitions="Auto,Auto,*,Auto,Auto">

      <Image Grid.Column="0" Source="avares://AstraUsb/Assets/logo.png"
             Height="30" Margin="12,0,12,0" VerticalAlignment="Center"
             Stretch="Uniform" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="Терминал BC-10" Classes="h2" FontSize="17" />
        <TextBlock Text="ТЕРМИНАЛ СБОРА И ХРАНЕНИЯ ДАННЫХ" Classes="label" />
      </StackPanel>

      <Border Grid.Column="3" Margin="0,0,10,0" Padding="12,4" CornerRadius="20"
              VerticalAlignment="Center" Background="{StaticResource BgAppBrush}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding ClockTime}" Classes="mono"
                     FontSize="19" FontWeight="Bold" VerticalAlignment="Center"
                     Foreground="{StaticResource FgMainBrush}" />
          <TextBlock Text="{Binding ClockDate}" FontSize="10" VerticalAlignment="Bottom"
                     Margin="0,0,0,3" Foreground="{StaticResource FgMutedBrush}" />
        </StackPanel>
      </Border>

      <Button Grid.Column="4" Classes="danger" Content="Выход" Margin="0,0,12,0"
              Height="40" Padding="18,0" VerticalAlignment="Center"
              Command="{Binding ExitCommand}" />
    </Grid>

    <!-- Строка состояния служб: по заданию она видна всегда -->
    <Grid Grid.Row="1" Background="{StaticResource BgPanelBrush}"
          ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,1">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                  Margin="12,0,0,8" VerticalAlignment="Center">
        <Border Padding="10,4" CornerRadius="14" Background="{StaticResource Teal100Brush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource Teal500Brush}" />
            <TextBlock Text="Монитор USB активен" FontSize="10"
                       Foreground="{StaticResource Teal900Brush}" />
          </StackPanel>
        </Border>
        <Border Padding="10,4" CornerRadius="14" Background="{StaticResource Neutral200Brush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource Teal500Brush}" />
            <TextBlock Text="Локальная база" FontSize="10"
                       Foreground="{StaticResource FgMutedBrush}" />
          </StackPanel>
        </Border>

        <Border Padding="10,4" CornerRadius="14" IsVisible="{Binding FtpEnabled}"
                Background="{StaticResource Accent100Brush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource Accent500Brush}" />
            <TextBlock Text="{Binding FtpLabel}" FontSize="10"
                       Foreground="{StaticResource Accent900Brush}" />
          </StackPanel>
        </Border>

        <!-- Состояние сети видно всегда: при её отсутствии отправка наружу
             молча копилась бы в очереди. -->
        <Border Padding="10,4" CornerRadius="14" Background="{StaticResource Neutral200Brush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource Neutral500Brush}"
                     IsVisible="{Binding !NetworkUp}" />
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource Teal500Brush}"
                     IsVisible="{Binding NetworkUp}" />
            <TextBlock Text="{Binding NetworkLabel}" FontSize="10"
                       Foreground="{StaticResource FgMutedBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="0,0,12,8"
                  VerticalAlignment="Center">
        <TextBlock Text="{Binding Summary}" FontSize="10"
                   VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}" />
        <TextBlock Text="{Binding Status}" FontSize="10"
                   VerticalAlignment="Center" Foreground="{StaticResource Accent700Brush}" />
      </StackPanel>
    </Grid>

    <TabControl x:Name="Tabs" Grid.Row="2" Padding="0" Background="Transparent">

      <TabItem Header="СБОР ДАННЫХ">
        <Grid RowDefinitions="Auto,*" Margin="10,8">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,6">
            <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
              <TextBlock Text="Сбор данных" Classes="h1" FontSize="22" LineHeight="26" />
              <TextBlock Classes="hint" MaxWidth="420" FontSize="10"
                         Text="Забирать регистратор можно, когда окно стало бирюзовым" />
            </StackPanel>

            <Border Grid.Column="1" Padding="4" CornerRadius="20" VerticalAlignment="Center"
                    Background="{StaticResource Neutral200Brush}">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="Сетка" Height="36" Padding="14,0" FontSize="12"
                        Classes.primary="{Binding IsGridLayout}"
                        Command="{Binding SetLayoutCommand}" CommandParameter="grid" />
                <Button Content="Список" Height="36" Padding="14,0" FontSize="12"
                        Classes.primary="{Binding IsListLayout}"
                        Command="{Binding SetLayoutCommand}" CommandParameter="list" />
                <Button Content="Схема" Height="36" Padding="14,0" FontSize="12"
                        Classes.primary="{Binding IsRackLayout}"
                        Command="{Binding SetLayoutCommand}" CommandParameter="rack" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Сетка: до двенадцати окон, компоновка по умолчанию -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Ports}"
                        IsVisible="{Binding IsGridLayout}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PortViewModel">
                <Border Classes="bay" Padding="10,8" Background="{Binding Fill}"
                        BorderBrush="{Binding Edge}">
                  <!-- Четыре строки и полоса: больше в окно при высоте
                       станции не влезает, не отняв у состояния его кегль. -->
                  <Grid RowDefinitions="22,*,Auto,3,7">

                    <Grid Grid.Row="0" ColumnDefinitions="22,*">
                      <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                              Background="{Binding Mark}">
                        <TextBlock Text="{Binding SlotLabel}" FontSize="11"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding SlotInk}" />
                      </Border>
                      <TextBlock Grid.Column="1" Margin="7,0,0,0" FontSize="11"
                                 FontWeight="SemiBold" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding EmployeeLine}" Foreground="{Binding Ink}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="{Binding StateText}" Classes="state"
                                 FontSize="17" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Foreground="{Binding Ink}" />
                      <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="mono"
                                 FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                 Foreground="{Binding Ink}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding StateHint}" FontSize="10"
                               TextTrimming="CharacterEllipsis" Foreground="{Binding InkMuted}" />

                    <Border Grid.Row="4" Height="7" CornerRadius="4" ClipToBounds="True"
                            Background="{Binding Track}">
                      <Border Classes="fill" HorizontalAlignment="Left" CornerRadius="4"
                              Width="{Binding BarFill}" Background="{Binding Mark}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Список: строки, когда окон больше двенадцати -->
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsListLayout}">
            <ItemsControl ItemsSource="{Binding Ports}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PortViewModel">
                  <Border Classes="bay" Padding="12,8" Margin="4,3"
                          Background="{Binding Fill}" BorderBrush="{Binding Edge}">
                    <Grid ColumnDefinitions="28,150,110,*,Auto">
                      <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                              Background="{Binding Mark}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SlotLabel}" FontSize="12"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding SlotInk}" />
                      </Border>

                      <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmployeeLine}" FontSize="12"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Ink}" />
                        <TextBlock Text="{Binding DepartmentLine}" FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding InkMuted}" />
                      </StackPanel>

                      <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                 FontFamily="{StaticResource FontHeading}"
                                 FontWeight="ExtraBold" FontSize="13"
                                 VerticalAlignment="Center" Foreground="{Binding Ink}" />

                      <Border Grid.Column="3" Height="7" CornerRadius="4" ClipToBounds="True"
                              VerticalAlignment="Center" Margin="8,0"
                              Background="{Binding Track}">
                        <Border Classes="fill" HorizontalAlignment="Left" CornerRadius="4"
                                Width="{Binding BarFill}" Background="{Binding Mark}" />
                      </Border>

                      <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                  HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PercentText}" Classes="mono" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Right"
                                   Foreground="{Binding Ink}" />
                        <TextBlock Text="{Binding FilesLine}" FontSize="10"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding InkMuted}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Схема стойки: карта отсеков для сверки номеров с железом -->
          <Border Grid.Row="1" Classes="panel" Padding="10" IsVisible="{Binding IsRackLayout}">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Margin="4,2,0,8" Classes="hint"
                         Text="Номера соответствуют физическим отсекам после сопоставления портов" />
              <ItemsControl Grid.Row="1" ItemsSource="{Binding Ports}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="148" ItemHeight="104" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PortViewModel">
                    <Border Classes="bay" Padding="8" Margin="4"
                            Background="{Binding Fill}" BorderBrush="{Binding Edge}">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <!-- Скоба сверху повторяет вид регистратора в отсеке -->
                        <Border Height="5" Width="40" CornerRadius="3"
                                HorizontalAlignment="Center" Background="{Binding Mark}" />
                        <Border Width="26" Height="26" CornerRadius="13"
                                HorizontalAlignment="Center" Background="{Binding Mark}">
                          <TextBlock Text="{Binding SlotLabel}" FontSize="12"
                                     FontFamily="{StaticResource FontHeading}"
                                     FontWeight="ExtraBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{Binding SlotInk}" />
                        </Border>
                        <TextBlock Text="{Binding StateText}" FontSize="11"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontWeight="ExtraBold" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Ink}" />
                        <TextBlock Text="{Binding EmployeeLine}" FontSize="10"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding InkMuted}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="ЗАПРОС ДАННЫХ">
        <Grid RowDefinitions="Auto,*,Auto" Margin="10,8">

          <!-- Панель условий по макету: поверхность со скруглением 30, поля в
               сетке от 210 точек на колонку, подпись над полем капсом. -->
          <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}"
                  CornerRadius="24" Padding="14,12" Margin="0,0,0,8">
            <StackPanel Spacing="10">
              <UniformGrid Columns="3" IsVisible="{Binding Search.FiltersExpanded}">
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="ОТДЕЛ" Classes="field" />
                  <ComboBox Classes="form" ItemsSource="{Binding Search.Departments}"
                            SelectedItem="{Binding Search.Department}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:DepartmentRow">
                        <TextBlock Text="{Binding Path}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="ТАБЕЛЬНЫЙ НОМЕР" Classes="field" />
                  <TextBox Classes="form" Text="{Binding Search.PersonnelNo}"
                           Watermark="например 10482" />
                </StackPanel>

                <StackPanel>
                  <TextBlock Text="СОТРУДНИК" Classes="field" />
                  <TextBox Classes="form" Text="{Binding Search.EmployeeName}"
                           Watermark="фамилия" />
                </StackPanel>
              </UniformGrid>

              <UniformGrid Columns="3" IsVisible="{Binding Search.FiltersExpanded}">
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="НОМЕР УСТРОЙСТВА" Classes="field" />
                  <TextBox Classes="form" Text="{Binding Search.Camera}"
                           Watermark="BCU-01-0001" />
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="ИМЯ ФАЙЛА" Classes="field" />
                  <TextBox Classes="form" Text="{Binding Search.FileName}"
                           Watermark="VID_" />
                </StackPanel>

                <StackPanel>
                  <TextBlock Text="ОТБОР" Classes="field" />
                  <CheckBox Content="только защищённые" FontSize="12" MinHeight="52"
                            IsChecked="{Binding Search.ProtectedOnly}" />
                </StackPanel>
              </UniformGrid>

              <UniformGrid Columns="3">
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="ЗАГРУЖЕНО В СТАНЦИЮ" Classes="field" />
                  <Grid ColumnDefinitions="*,10,*">
                    <TextBox Grid.Column="0" Classes="form" Text="{Binding Search.From}" />
                    <TextBox Grid.Column="2" Classes="form" Text="{Binding Search.To}" />
                  </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="ВРЕМЯ СЪЁМКИ" Classes="field" />
                  <Grid ColumnDefinitions="*,10,*">
                    <TextBox Grid.Column="0" Classes="form" Text="{Binding Search.ShotFrom}"
                             Watermark="любое" />
                    <TextBox Grid.Column="2" Classes="form" Text="{Binding Search.ShotTo}"
                             Watermark="любое" />
                  </Grid>
                </StackPanel>

                <StackPanel>
                  <TextBlock Text="ТИП ФАЙЛА" Classes="field" />
                  <ComboBox Classes="form" ItemsSource="{Binding Search.Kinds}"
                            SelectedIndex="{Binding Search.KindIndex}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
              </UniformGrid>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Запрос" Height="52" Width="140"
                        IsEnabled="{Binding !Search.Searching}"
                        Command="{Binding Search.SearchCommand}" />
                <Button Content="Сброс" Height="52" Width="110"
                        Command="{Binding Search.ResetCommand}" />
                <Button Content="{Binding Search.FiltersLabel}" Height="52" FontSize="12"
                        Command="{Binding Search.ToggleFiltersCommand}" />
                <TextBlock Text="{Binding Search.Hint}" Classes="hint" VerticalAlignment="Center"
                           Foreground="{StaticResource Accent700Brush}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Classes="card">
            <Grid RowDefinitions="26,*">
              <Grid Grid.Row="0" ColumnDefinitions="30,86,*,54,54,86,76,76,52" Margin="12,7,12,0">
                <TextBlock Grid.Column="1" Text="УСТРОЙСТВО" Classes="label" />
                <TextBlock Grid.Column="2" Text="ФАЙЛ" Classes="label" />
                <TextBlock Grid.Column="3" Text="ТИП" Classes="label" />
                <TextBlock Grid.Column="4" Text="РАЗМЕР" Classes="label" />
                <TextBlock Grid.Column="5" Text="СОТРУДНИК" Classes="label" />
                <TextBlock Grid.Column="6" Text="СНЯТО" Classes="label" />
                <TextBlock Grid.Column="7" Text="ЗАГРУЖЕНО" Classes="label" />
                <TextBlock Grid.Column="8" Text="ЗАЩИТА" Classes="label" />
              </Grid>

              <ListBox Grid.Row="1" ItemsSource="{Binding Search.Results}"
                       SelectedItem="{Binding Search.Current}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FoundFile">
                    <Grid ColumnDefinitions="30,86,*,54,54,86,76,76,52" Height="34">
                      <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" MinHeight="30"
                                VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Camera}" Classes="mono"
                                 FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource Accent700Brush}" />
                      <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="12"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding Kind}" FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource FgMutedBrush}" />
                      <TextBlock Grid.Column="4" Text="{Binding Size}" FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource FgMutedBrush}" />
                      <TextBlock Grid.Column="5" Text="{Binding Employee}" FontSize="11"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource FgMutedBrush}" />
                      <TextBlock Grid.Column="6" Text="{Binding ShotAt}" Classes="mono"
                                 FontSize="10" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource FgMutedBrush}" />
                      <TextBlock Grid.Column="7" Text="{Binding CollectedAt}" Classes="mono"
                                 FontSize="10" VerticalAlignment="Center"
                                 Foreground="{StaticResource FgMutedBrush}" />
                      <TextBlock Grid.Column="8" Text="{Binding Mark}" FontSize="10"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource WarnBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
            <!-- Действия над выбранной записью -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Смотреть" Height="46" FontSize="12"
                      Command="{Binding Search.PlayCommand}" />
              <ComboBox ItemsSource="{Binding Search.Formats}"
                        SelectedItem="{Binding Search.Format}" Width="96" Height="46" />
              <Button Content="Перевести" Height="46" FontSize="12"
                      IsEnabled="{Binding !Search.Converting}"
                      Command="{Binding Search.ConvertFileCommand}" />
              <TextBox Text="{Binding Search.NoteInput}" Width="160" Height="46"
                       Watermark="заметка" />
              <Button Content="Заметка" Height="46" FontSize="12"
                      Command="{Binding Search.SaveNoteCommand}" />
              <Button Content="Защита" Height="46" FontSize="12"
                      Command="{Binding Search.ToggleImportantCommand}" />
            </StackPanel>

            <!-- Действия над отобранными галочками -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Отобрать все" Height="46" FontSize="12"
                      Command="{Binding Search.SelectAllCommand}" />
              <TextBox Text="{Binding Search.ExportTarget}" Width="230" Height="46"
                       Watermark="куда выгрузить: папка или флешка" />
              <Button Classes="primary" Content="{Binding Search.ExportLabel}" Height="46"
                      FontSize="12" IsEnabled="{Binding !Search.Exporting}"
                      Command="{Binding Search.ExportCommand}" />
              <Button Classes="danger" Content="{Binding Search.DeleteLabel}" Height="46"
                      FontSize="12" Command="{Binding Search.DeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="УСТРОЙСТВА">
        <Grid RowDefinitions="*,Auto" Margin="10,8">
          <!-- Панель управления прижата к низу и получает место раньше списка:
               на экране 1024x600 иначе она уезжает за край. -->
          <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <Grid RowDefinitions="24,*">
              <Grid Grid.Row="0" ColumnDefinitions="96,124,*,96,58" Margin="10,6,10,0">
                <TextBlock Grid.Column="0" Text="КАМЕРА" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="1" Text="СОТРУДНИК" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="2" Text="ОТДЕЛ" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="3" Text="ЗАГРУЖЕНО" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="4" Text="ДИСК" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding Devices.Devices}"
                     SelectedItem="{Binding Devices.Selected}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceRow">
                  <Grid ColumnDefinitions="96,124,*,96,58" Height="30">
                    <TextBlock Grid.Column="0" Text="{Binding Display}"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource Accent700Brush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Employee}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Department}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding LastSeen}"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding Label}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <!-- Панель в две строки: в одну на экране станции она не помещается
               и уезжает за правый край вместе с кнопками. -->
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Имя камеры" Width="86" FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding Devices.NameInput}" Width="190" Height="44" />
              <Button Content="Переименовать" Height="44" FontSize="12"
                      Command="{Binding Devices.RenameCommand}" />
              <Button Content="Обновить" Height="44" FontSize="12"
                      Command="{Binding Devices.ReloadCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Сотрудник" Width="86" FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}" />
              <ComboBox ItemsSource="{Binding Devices.Employees}"
                        SelectedItem="{Binding Devices.EmployeeInput}" Width="190" Height="44">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:Employee">
                    <TextBlock Text="{Binding FullName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Закрепить" Height="44" FontSize="12"
                      Command="{Binding Devices.AssignCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding Devices.Hint}" Classes="hint"
                       Foreground="{StaticResource Accent700Brush}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="СОТРУДНИКИ">
        <Grid ColumnDefinitions="224,*" RowDefinitions="*,Auto" Margin="10,8">

          <!-- Отделы. Путь показан целиком: вложенность иначе не видна. -->
          <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,0"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <Grid RowDefinitions="24,*">
              <TextBlock Grid.Row="0" Text="ОТДЕЛЫ" Margin="10,6,0,0" FontSize="10"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBlock Grid.Row="1" IsVisible="{Binding Staff.NoDepartments}"
                         Text="Отделов пока нет. Введите название внизу и нажмите «Добавить отдел»."
                         Margin="12,8" TextWrapping="Wrap" FontSize="11"
                         Foreground="{StaticResource FgMutedBrush}" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Staff.Departments}"
                       SelectedItem="{Binding Staff.SelectedDepartment}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DepartmentRow">
                    <TextBlock Text="{Binding Path}" Height="26" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Row="0" Grid.Column="1"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <Grid RowDefinitions="24,*">
              <Grid Grid.Row="0" ColumnDefinitions="84,*,104,58" Margin="10,6,10,0">
                <TextBlock Grid.Column="0" Text="НОМЕР" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="1" Text="ИМЯ" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="2" Text="ТЕЛЕФОН" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding Staff.Employees}"
                     SelectedItem="{Binding Staff.Selected}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="svc:Employee">
                  <Grid ColumnDefinitions="84,*,104,58" Height="28">
                    <TextBlock Grid.Column="0" Text="{Binding PersonnelNo}"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource Accent700Brush}" />
                    <TextBlock Grid.Column="1" Text="{Binding FullName}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Phone}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="уволен" IsVisible="{Binding !Active}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" Margin="0,8,8,0">
            <TextBox Text="{Binding Staff.DepartmentNameInput}" Height="44"
                     Watermark="Название отдела" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Добавить" Height="44" FontSize="12"
                      Command="{Binding Staff.AddDepartmentCommand}" />
              <Button Content="Удалить" Height="44" FontSize="12"
                      Command="{Binding Staff.DeleteDepartmentCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- Карточка сотрудника по строкам: в одну строку четыре поля и три
               кнопки на экране станции не помещаются. -->
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding Staff.PersonnelNoInput}" Width="96" Height="44"
                       Watermark="номер" Classes="mono" />
              <TextBox Text="{Binding Staff.FullNameInput}" Width="200" Height="44"
                       Watermark="фамилия и инициалы" />
              <TextBox Text="{Binding Staff.PhoneInput}" Width="140" Height="44"
                       Watermark="телефон" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
              <ComboBox ItemsSource="{Binding Staff.Departments}"
                        SelectedItem="{Binding Staff.DepartmentInput}" Width="180" Height="44">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DepartmentRow">
                    <TextBlock Text="{Binding Path}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Новый" Height="44" FontSize="12"
                      Command="{Binding Staff.NewEmployeeCommand}" />
              <Button Classes="primary" Content="Сохранить" Height="44" FontSize="12"
                      Command="{Binding Staff.SaveEmployeeCommand}" />
              <Button Content="Уволить" Height="44" FontSize="12"
                      Command="{Binding Staff.DeactivateCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding Staff.Hint}" Classes="hint"
                       Foreground="{StaticResource Accent700Brush}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="ЖУРНАЛ">
        <Grid RowDefinitions="Auto,*,Auto" Margin="10,8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="События с" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}" />
            <TextBox Text="{Binding Log.From}" Width="100" Height="44" />
            <TextBlock Text="по" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource FgMutedBrush}" />
            <TextBox Text="{Binding Log.To}" Width="100" Height="44" />
            <Button Classes="primary" Content="Показать" Height="44" FontSize="12"
                    Command="{Binding Log.ReloadCommand}" />
            <Button Content="Сегодня" Height="44" FontSize="12"
                    Command="{Binding Log.TodayCommand}" />
            <Button Content="Неделя" Height="44" FontSize="12"
                    Command="{Binding Log.WeekCommand}" />
          </StackPanel>

          <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <Grid RowDefinitions="24,*">
              <Grid Grid.Row="0" ColumnDefinitions="112,84,*" Margin="10,6,10,0">
                <TextBlock Grid.Column="0" Text="КОГДА" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="1" Text="СОБЫТИЕ" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
                <TextBlock Grid.Column="2" Text="ЧТО ПРОИЗОШЛО" FontSize="10"
                           Foreground="{StaticResource FgMutedBrush}" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding Log.Entries}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogRow">
                    <Grid ColumnDefinitions="112,84,*" Height="24">
                      <TextBlock Grid.Column="0" Text="{Binding At}" FontSize="11"
                                 FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource FgMutedBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource Accent700Brush}" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Foreground="{StaticResource FgMainBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <TextBlock Grid.Row="2" Text="{Binding Log.Hint}" FontSize="11" Margin="0,6,0,0"
                     Foreground="{StaticResource Accent700Brush}" />
        </Grid>
      </TabItem>

      <TabItem Header="НАСТРОЙКИ">
        <!-- Боковое меню и один подраздел справа, как в прототипе: одной
             простынёй с прокруткой на экране станции не пользоваться, а
             искать в ней нужное поле. -->
        <Grid ColumnDefinitions="176,*" Margin="10,8">

          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <Button Classes="nav" Content="Станция и хранилище"
                    Classes.primary="{Binding Settings.IsStationSection}"
                    Command="{Binding Settings.OpenSectionCommand}" CommandParameter="station" />
            <Button Classes="nav" Content="Доступ"
                    Classes.primary="{Binding Settings.IsAccessSection}"
                    Command="{Binding Settings.OpenSectionCommand}" CommandParameter="access" />
            <Button Classes="nav" Content="Разметка гнёзд"
                    Classes.primary="{Binding Settings.IsSlotsSection}"
                    Command="{Binding Settings.OpenSectionCommand}" CommandParameter="slots" />
            <Button Classes="nav" Content="Отправка на сервер"
                    Classes.primary="{Binding Settings.IsFtpSection}"
                    Command="{Binding Settings.OpenSectionCommand}" CommandParameter="ftp" />
            <Button Classes="nav" Content="Внешняя база"
                    Classes.primary="{Binding Settings.IsSqlSection}"
                    Command="{Binding Settings.OpenSectionCommand}" CommandParameter="sql" />
            <Button Classes="nav" Content="Веб-панель"
                    Classes.primary="{Binding Settings.IsWebSection}"
                    Command="{Binding Settings.OpenSectionCommand}" CommandParameter="web" />
            <Button Classes="nav" Content="О программе"
                    Classes.primary="{Binding Settings.IsAboutSection}"
                    Command="{Binding Settings.OpenSectionCommand}" CommandParameter="about" />
          </StackPanel>

          <Border Grid.Column="1" Classes="card" Padding="16">
            <Grid RowDefinitions="*,Auto">

              <!-- Станция и хранилище -->
              <ScrollViewer Grid.Row="0" IsVisible="{Binding Settings.IsStationSection}">
                <StackPanel Spacing="14">
                  <TextBlock Text="Станция и хранилище" Classes="section" />

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="НОМЕР СТАНЦИИ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.StationNumber}" />
                      <TextBlock Classes="hint" Margin="0,4,0,0"
                                 Text="входит в номера, которые станция выдаёт камерам" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ОКОН СБОРА" Classes="field" />
                      <Grid ColumnDefinitions="*,8,Auto">
                        <TextBox Grid.Column="0" Classes="form"
                                 Text="{Binding Settings.BayCount}" />
                        <Button Grid.Column="2" Content="Применить" Height="52"
                                Command="{Binding Settings.SaveBayCountCommand}" />
                      </Grid>
                      <TextBlock Classes="hint" Margin="0,4,0,0"
                                 Text="от 6 до 30, вступает в силу после перезапуска" />
                    </StackPanel>
                  </UniformGrid>

                  <TextBlock IsVisible="{Binding Settings.RestartNeeded}" Classes="hint"
                             Foreground="{StaticResource WarnBrush}"
                             Text="Число окон изменено. Перезапустите программу, чтобы доска перестроилась." />

                  <StackPanel>
                    <TextBlock Text="ПАПКА АРХИВА" Classes="field" />
                    <TextBox Classes="form" Text="{Binding Settings.BackupRoot}" />
                    <TextBlock IsVisible="{Binding Settings.ArchiveOnSystemDrive}" Classes="hint"
                               Margin="0,4,0,0" Foreground="{StaticResource WarnBrush}"
                               Text="Архив на системном разделе. Выберите отдельный диск: системный переполнится записями." />
                  </StackPanel>

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="ОСТАВЛЯТЬ СВОБОДНЫМИ, ГБ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.MinFreeGb}" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ХРАНИТЬ ЗАПИСИ, ДНЕЙ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.KeepDays}" />
                      <TextBlock Classes="hint" Margin="0,4,0,0" Text="0 хранит бессрочно" />
                    </StackPanel>
                  </UniformGrid>

                  <StackPanel>
                    <TextBlock Text="КОГДА МЕСТО КОНЧАЕТСЯ" Classes="field" />
                    <ComboBox Classes="form" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Settings.StorageModes}"
                              SelectedIndex="{Binding Settings.StorageModeIndex}" />
                  </StackPanel>

                  <CheckBox Content="Удалять видео с регистратора после подтверждённой загрузки"
                            IsChecked="{Binding Settings.DeleteVideoAfterCopy}" />

                  <CheckBox Content="Звуковая тревога при нехватке места и обрыве сети"
                            IsChecked="{Binding Settings.AlarmSound}" />

                  <CheckBox Content="Голосовые подсказки о готовности отсеков"
                            IsChecked="{Binding Settings.VoiceHints}" />
                  <TextBlock Classes="hint"
                             Text="Синтез речи берётся системный. Если его в системе нет, подсказки молчат, а работа станции не меняется." />

                  <Button Classes="primary" Content="Сохранить" Height="52" Width="180"
                          HorizontalAlignment="Left"
                          Command="{Binding Settings.SaveStorageCommand}" />
                </StackPanel>
              </ScrollViewer>

              <!-- Доступ -->
              <ScrollViewer Grid.Row="0" IsVisible="{Binding Settings.IsAccessSection}">
                <StackPanel Spacing="14">
                  <TextBlock Text="Доступ" Classes="section" />
                  <TextBlock Classes="hint"
                             Text="Учётной записью администратора закрыты выход из программы и все разделы, кроме сбора данных." />
                  <TextBlock IsVisible="{Binding Settings.UsingDefaultPassword}" Classes="hint"
                             Foreground="{StaticResource WarnBrush}"
                             Text="Пароль ещё не меняли: станция открывается стандартным из задания." />

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="УЧЁТНАЯ ЗАПИСЬ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.AdminAccount}" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ТЕКУЩИЙ ПАРОЛЬ" Classes="field" />
                      <TextBox Classes="form" PasswordChar="●"
                               Text="{Binding Settings.CurrentPassword}" />
                    </StackPanel>
                  </UniformGrid>

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="НОВЫЙ ПАРОЛЬ" Classes="field" />
                      <TextBox Classes="form" PasswordChar="●"
                               Text="{Binding Settings.NewPassword}" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ПОВТОРИТЕ НОВЫЙ" Classes="field" />
                      <TextBox Classes="form" PasswordChar="●"
                               Text="{Binding Settings.RepeatPassword}" />
                    </StackPanel>
                  </UniformGrid>

                  <Button Classes="primary" Content="Сменить пароль" Height="52" Width="220"
                          HorizontalAlignment="Left"
                          Command="{Binding Settings.ChangePasswordCommand}" />

                  <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,4" />

                  <StackPanel>
                    <TextBlock Text="ЗАКРЫВАТЬ РАЗДЕЛЫ ЧЕРЕЗ, МИН ПРОСТОЯ" Classes="field" />
                    <Grid ColumnDefinitions="*,8,Auto" Width="360" HorizontalAlignment="Left">
                      <TextBox Grid.Column="0" Classes="form"
                               Text="{Binding Settings.LockTimeoutMinutes}" />
                      <Button Grid.Column="2" Content="Сохранить" Height="52"
                              Command="{Binding Settings.SaveLockTimeoutCommand}" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,4,0,0"
                               Text="0 отключает закрытие по простою" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>

              <!-- Разметка гнёзд -->
              <Grid Grid.Row="0" IsVisible="{Binding Settings.IsSlotsSection}"
                    RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Разметка гнёзд" Classes="section" />
                <TextBlock Grid.Row="1" Classes="hint" Margin="0,4,0,8"
                           Text="Отключите все регистраторы. Вставляйте по одному и нажимайте «Сопоставить» напротив нужного окна." />

                <ScrollViewer Grid.Row="2">
                  <ItemsControl ItemsSource="{Binding Settings.Slots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SlotRow">
                        <Grid ColumnDefinitions="70,*,Auto" Height="42">
                          <TextBlock Grid.Column="0" Text="{Binding SlotLabel}" FontSize="12"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding PortLabel}" Classes="mono"
                                     FontSize="11" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{StaticResource FgMutedBrush}" />
                          <Button Grid.Column="2" Classes="compact" Content="Сопоставить"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MapSlotCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="3" Content="Снять разметку" HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Command="{Binding Settings.ClearSlotsCommand}" />
              </Grid>

              <!-- Отправка на сервер -->
              <ScrollViewer Grid.Row="0" IsVisible="{Binding Settings.IsFtpSection}">
                <StackPanel Spacing="14">
                  <TextBlock Text="Отправка на сервер" Classes="section" />
                  <TextBlock Classes="hint"
                             Text="Записи уходят на сервер после того, как легли в архив, и никогда вместо него. При обрыве связи они остаются в очереди и уйдут, когда сеть вернётся." />

                  <CheckBox Content="Отправлять собранные записи на сервер FTP"
                            IsChecked="{Binding Settings.FtpEnabled}" />

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="АДРЕС СЕРВЕРА" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.FtpHost}"
                               Watermark="192.168.0.10" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ПОРТ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.FtpPort}" />
                    </StackPanel>
                  </UniformGrid>

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="УЧЁТНАЯ ЗАПИСЬ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.FtpUser}" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ПАРОЛЬ" Classes="field" />
                      <TextBox Classes="form" PasswordChar="●"
                               Text="{Binding Settings.FtpPassword}" />
                    </StackPanel>
                  </UniformGrid>

                  <StackPanel>
                    <TextBlock Text="ПАПКА НА СЕРВЕРЕ" Classes="field" />
                    <TextBox Classes="form" Text="{Binding Settings.FtpFolder}"
                             Watermark="можно оставить пустой" />
                  </StackPanel>

                  <CheckBox Content="Защищённое соединение"
                            IsChecked="{Binding Settings.FtpSsl}" />

                  <TextBlock Classes="hint"
                             Text="Пароль сервера хранится в файле настроек как есть: клиент предъявляет его при каждой отправке. Защита здесь это права на папку data, а не шифрование." />

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Сохранить" Height="52" Width="150"
                            Command="{Binding Settings.SaveFtpCommand}" />
                    <Button Content="Проверить" Height="52" Width="150"
                            IsEnabled="{Binding !Settings.FtpTesting}"
                            Command="{Binding Settings.TestFtpCommand}" />
                    <Button Content="Повторить отложенные" Height="52"
                            Command="{Binding Settings.RetryFtpCommand}" />
                  </StackPanel>

                  <TextBlock Text="{Binding Settings.FtpState}" Classes="hint"
                             Foreground="{StaticResource Accent700Brush}" />
                </StackPanel>
              </ScrollViewer>

              <!-- Внешняя база -->
              <ScrollViewer Grid.Row="0" IsVisible="{Binding Settings.IsSqlSection}">
                <StackPanel Spacing="14">
                  <TextBlock Text="Внешняя база" Classes="section" />
                  <TextBlock Classes="hint"
                             Text="Станция работает на своей базе рядом с программой, и настраивать здесь нечего, пока внешнего сервера нет." />
                  <TextBlock Classes="hint" Foreground="{StaticResource WarnBrush}"
                             Text="Пока станция только проверяет, отвечает ли сервер на своём порту. Хранение записей на внешней базе не ведётся: драйвер чужой базы в сборку станции не входит." />

                  <CheckBox Content="Работать с внешним сервером базы"
                            IsChecked="{Binding Settings.SqlEnabled}" />

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="СЕРВЕР" Classes="field" />
                      <ComboBox Classes="form" HorizontalAlignment="Stretch"
                                ItemsSource="{Binding Settings.SqlKinds}"
                                SelectedIndex="{Binding Settings.SqlKindIndex}" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ПОРТ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.SqlPort}" />
                    </StackPanel>
                  </UniformGrid>

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="АДРЕС" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.SqlHost}"
                               Watermark="192.168.0.20" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ИМЯ БАЗЫ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.SqlDatabase}" />
                    </StackPanel>
                  </UniformGrid>

                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="УЧЁТНАЯ ЗАПИСЬ" Classes="field" />
                      <TextBox Classes="form" Text="{Binding Settings.SqlUser}" />
                    </StackPanel>

                    <StackPanel>
                      <TextBlock Text="ПАРОЛЬ" Classes="field" />
                      <TextBox Classes="form" PasswordChar="●"
                               Text="{Binding Settings.SqlPassword}" />
                    </StackPanel>
                  </UniformGrid>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Сохранить" Height="52" Width="150"
                            Command="{Binding Settings.SaveSqlCommand}" />
                    <Button Content="Проверить" Height="52" Width="150"
                            IsEnabled="{Binding !Settings.SqlTesting}"
                            Command="{Binding Settings.TestSqlCommand}" />
                  </StackPanel>

                  <TextBlock Text="{Binding Settings.SqlState}" Classes="hint"
                             Foreground="{StaticResource Accent700Brush}" />
                </StackPanel>
              </ScrollViewer>

              <!-- Веб-панель -->
              <ScrollViewer Grid.Row="0" IsVisible="{Binding Settings.IsWebSection}">
                <StackPanel Spacing="14">
                  <TextBlock Text="Веб-панель" Classes="section" />
                  <TextBlock Classes="hint"
                             Text="Панель показывает состояние отсеков, архив и журнал с телефона или компьютера в той же сети. Один адрес, одни данные, раскладка меняется по ширине экрана." />
                  <TextBlock Classes="hint" Foreground="{StaticResource WarnBrush}"
                             Text="Соединение идёт без шифрования, поэтому панель годится только для локальной сети. Выключена по умолчанию: открытый порт на станции это решение того, кто её ставит." />

                  <CheckBox Content="Открыть веб-панель"
                            IsChecked="{Binding Settings.WebEnabled}" />

                  <StackPanel>
                    <TextBlock Text="ПОРТ" Classes="field" />
                    <Grid ColumnDefinitions="*,8,Auto" Width="360" HorizontalAlignment="Left">
                      <TextBox Grid.Column="0" Classes="form"
                               Text="{Binding Settings.WebPort}" />
                      <Button Grid.Column="2" Classes="primary" Content="Сохранить" Height="52"
                              Command="{Binding Settings.SaveWebCommand}" />
                    </Grid>
                  </StackPanel>

                  <TextBlock Text="{Binding Settings.WebState}" Classes="hint"
                             Foreground="{StaticResource Accent700Brush}" />
                  <TextBlock Classes="hint"
                             Text="Вход в панель по той же учётной записи администратора, что и в разделы станции. Пять неудачных попыток подряд закрывают вход на минуту." />
                </StackPanel>
              </ScrollViewer>

              <!-- О программе -->
              <StackPanel Grid.Row="0" IsVisible="{Binding Settings.IsAboutSection}" Spacing="8">
                <TextBlock Text="О программе" Classes="section" />
                <TextBlock Text="BestCam BC-10" Classes="h2" FontSize="16" />
                <TextBlock Text="Терминал сбора и хранения данных" Classes="hint" />
                <TextBlock Text="{Binding Version}" Classes="mono" FontSize="12" />
                <TextBlock Classes="hint"
                           Text="Записи собираются с регистраторов автоматически при подключении. Выход из программы и разделы, кроме сбора данных, закрыты учётной записью администратора." />
              </StackPanel>

              <TextBlock Grid.Row="1" Text="{Binding Settings.Hint}" Classes="hint"
                         Margin="0,10,0,0" Foreground="{StaticResource Accent700Brush}" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

    </TabControl>

    <!-- Нижняя строка: слева марка, по центру заполнение хранилища, справа состояние -->
    <Grid Grid.Row="3" Background="{StaticResource BgPanelBrush}"
          ColumnDefinitions="Auto,*,Auto">
      <Border Grid.Column="0" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top"
              Background="{StaticResource LineBrush}" />
      <TextBlock Grid.Column="0" Text="© BestCam" Margin="12,0" FontSize="10"
                 VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding StorageLabel}" FontSize="10"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource FgMutedBrush}" />
        <Border Width="150" Height="6" CornerRadius="1"
                Background="{StaticResource BgSurfaceBrush}" ClipToBounds="True">
          <Border HorizontalAlignment="Left" Width="{Binding StorageWidth}"
                  Background="{Binding StorageBrush}">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.6" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.4" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Border>
      </StackPanel>

      <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="12,0" FontSize="10"
                 VerticalAlignment="Center" Foreground="{StaticResource Accent700Brush}"
                 />
    </Grid>

    <!-- Карточка отсека. Открывается нажатием по окну и не требует пароля:
         это работа сменного оператора, а не администратора. -->
    <Border Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding BayVisible}"
            Background="#8C212D3B">
      <Border Width="460" Padding="22" CornerRadius="20"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource BgPanelBrush}"
              BoxShadow="{StaticResource ShadowLg}">
        <StackPanel Spacing="14" DataContext="{Binding Bay}"
                    x:CompileBindings="False">

          <Grid ColumnDefinitions="34,*,Auto">
            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                    Background="{Binding Mark}">
              <TextBlock Text="{Binding SlotLabel}" FontSize="15"
                         FontFamily="{StaticResource FontHeading}" FontWeight="ExtraBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{Binding SlotInk}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding BayTitle}" Classes="h2" FontSize="18"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DepartmentLine}" Classes="hint" />
            </StackPanel>

            <Border Grid.Column="2" Padding="12,6" CornerRadius="16"
                    VerticalAlignment="Center" Background="{Binding Fill}"
                    BorderBrush="{Binding Edge}" BorderThickness="1">
              <TextBlock Text="{Binding StateText}" FontSize="12"
                         FontFamily="{StaticResource FontHeading}" FontWeight="ExtraBold"
                         Foreground="{Binding Ink}" />
            </Border>
          </Grid>

          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="НОМЕР УСТРОЙСТВА" Classes="label" />
              <TextBlock Text="{Binding CameraLine}" Classes="mono" FontSize="13"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="ТАБЕЛЬНЫЙ НОМЕР" Classes="label" />
              <TextBlock Text="{Binding PersonnelLine}" Classes="mono" FontSize="13" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="ОТСЕК" Classes="label" />
              <TextBlock Text="{Binding SlotLabel}" Classes="mono" FontSize="13" />
            </StackPanel>
          </UniformGrid>

          <StackPanel Spacing="5">
            <Border Height="9" CornerRadius="5" ClipToBounds="True"
                    Background="{Binding Track}">
              <Border Classes="fill" HorizontalAlignment="Left" CornerRadius="5"
                      Width="{Binding BarFill}" Background="{Binding Mark}" />
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding FilesLine}" Classes="hint" />
              <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="mono"
                         FontSize="12" FontWeight="Bold" />
            </Grid>
          </StackPanel>

          <!-- Действия принадлежат окну, а не отсеку, поэтому команды берутся
               у модели окна. Каждое требует второго нажатия: оба необратимы
               для идущей выгрузки. -->
          <StackPanel Spacing="8">
            <TextBlock Classes="hint" Foreground="{StaticResource WarnBrush}"
                       IsVisible="{Binding $parent[Window].DataContext.BayConfirm,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="Нажмите то же действие ещё раз, чтобы подтвердить" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Первым в очередь" Height="46" FontSize="12"
                      Command="{Binding $parent[Window].DataContext.PrioritizeBayCommand}" />
              <Button Content="Только зарядка" Height="46" FontSize="12"
                      IsVisible="{Binding !IsChargeOnly}"
                      Command="{Binding $parent[Window].DataContext.ChargeOnlyBayCommand}" />
              <Button Content="Возобновить" Height="46" FontSize="12"
                      IsVisible="{Binding IsChargeOnly}"
                      Command="{Binding $parent[Window].DataContext.ResumeBayCommand}" />
              <Button Content="Закрыть" Height="46" FontSize="12"
                      Command="{Binding $parent[Window].DataContext.CloseBayCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Запрос пароля. Перекрывает весь экран: в киоске это единственная
         преграда между посторонним и выходом из программы. -->
    <Border Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding PasswordVisible}"
            Background="#E6050A14">
      <Border Width="580" Padding="24" CornerRadius="2"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource Accent700Brush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding PasswordPrompt}" FontSize="15" FontWeight="Bold"
                     Foreground="{StaticResource FgMainBrush}" />
          <TextBlock Text="Введите учётную запись и пароль администратора" FontSize="11"
                     Foreground="{StaticResource FgMutedBrush}" />

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,16,0">
              <TextBlock Text="УЧЁТНАЯ ЗАПИСЬ" FontSize="10"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding AccountInput}" FontSize="15" />

              <TextBlock Text="ПАРОЛЬ" FontSize="10" Margin="0,4,0,0"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox x:Name="PasswordBox" PasswordChar="●" FontSize="16"
                       Text="{Binding PasswordInput}" />

              <TextBlock Text="{Binding PasswordError}" FontSize="11"
                         TextWrapping="Wrap" Foreground="#FF3B5C" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Войти" IsDefault="True" Height="46" Width="120"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ConfirmPasswordCommand}" />
                <Button Content="Отмена" Height="46" Width="120"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CancelPasswordCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Экранная клавиатура: станция сенсорная, физической
                 клавиатуры у неё нет, а пароль по заданию цифровой. -->
            <UniformGrid Grid.Column="1" Columns="3" Rows="4" Width="216">
            <Button Content="1" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="1" />
            <Button Content="2" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="2" />
            <Button Content="3" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="3" />
            <Button Content="4" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="4" />
            <Button Content="5" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="5" />
            <Button Content="6" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="6" />
            <Button Content="7" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="7" />
            <Button Content="8" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="8" />
            <Button Content="9" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="9" />
            <Button Content="C" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="C" />
            <Button Content="0" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="0" />
            <Button Content="←" Height="52" Margin="3" FontSize="18" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PasswordKeyCommand}" CommandParameter="&lt;" />
            </UniformGrid>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
