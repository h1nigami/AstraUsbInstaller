<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AstraUsb.ViewModels"
        xmlns:svc="clr-namespace:AstraUsb.Services"
        x:Class="AstraUsb.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BestCam USB Backup Manager"
        Width="1024" Height="600"
        WindowState="FullScreen"
        SystemDecorations="None"
        Background="{StaticResource BgAppBrush}"
        FontFamily="Noto Sans, DejaVu Sans, Segoe UI, sans-serif">

  <Window.Styles>
    <!-- Плитка порта. Она же индикатор: заливка снизу вверх показывает долю
         скопированного и читается через комнату, в отличие от процентов. -->
    <Style Selector="Border.port">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Слой заливки растёт плавно, а не рывком на каждый отчёт о прогрессе. -->
    <Style Selector="Border.fill">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Height" Duration="0:0:0.45" Easing="CubicEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.35" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Номер устройства — моноширинным: цифры не пляшут при смене значения. -->
    <Style Selector="TextBlock.portNumber">
      <Setter Property="FontFamily" Value="DejaVu Sans Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource FgMainBrush}" />
    </Style>

    <Style Selector="TextBlock.portState">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.portDetail">
      <Setter Property="FontFamily" Value="DejaVu Sans Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource FgMainBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
    </Style>

    <Style Selector="Button.exit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentDangerBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentDangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.exit:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A0F1A" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="58,1,*,28">

    <!-- Шапка -->
    <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}"
          ColumnDefinitions="Auto,Auto,*,Auto,Auto">

      <Border Grid.Column="0" Margin="14,0,10,0" Padding="9,3"
              BorderBrush="{StaticResource BrandBrush}" BorderThickness="1"
              CornerRadius="2" VerticalAlignment="Center">
        <TextBlock Text="BestCam" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource BrandBrush}" />
      </Border>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
        <TextBlock Text="USB BACKUP MANAGER" FontSize="13" FontWeight="Bold"
                   LetterSpacing="2.6" Foreground="{StaticResource FgMainBrush}" />
        <TextBlock Text="{Binding Version}" FontSize="10"
                   LetterSpacing="0.8" Foreground="{StaticResource FgMutedBrush}" />
      </StackPanel>

      <!-- Часы станции: по ним сверяют время регистраторов. -->
      <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,18,0"
                  HorizontalAlignment="Right" Spacing="0">
        <TextBlock Text="{Binding ClockTime}"
                   FontFamily="DejaVu Sans Mono, Consolas, monospace"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource BrandBrush}" />
        <TextBlock Text="{Binding ClockDate}" FontSize="10"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource FgMutedBrush}" />
      </StackPanel>

      <Button Grid.Column="4" Classes="exit" Content="ВЫХОД" Margin="0,0,14,0"
              VerticalAlignment="Center" Command="{Binding ExitCommand}" />
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource BrandBrush}" Opacity="0.55" />

    <TabControl Grid.Row="2" Padding="0" Background="Transparent">

      <TabItem Header="ЗАГРУЗКА">
        <ItemsControl ItemsSource="{Binding Ports}" Margin="9,7">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="5" Rows="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PortViewModel">
              <Border Classes="port" Margin="4" BorderBrush="{Binding Edge}">
                <Grid>
                  <Border Classes="fill" VerticalAlignment="Bottom"
                          Background="{Binding Fill}"
                          Height="{Binding FillHeight}" Opacity="0.9" />
                  <!-- Тонкая линия сверху: занятый порт видно и без цвета заливки -->
                  <Border VerticalAlignment="Top" Height="2"
                          Background="{Binding Edge}" />
                  <StackPanel Margin="11,10" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Classes="portNumber" Text="{Binding Title}" />
                    <TextBlock Classes="portState" Text="{Binding StateText}" />
                    <TextBlock Classes="portDetail" Text="{Binding Detail}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </TabItem>

      <TabItem Header="ПОИСК">
        <TextBlock Margin="16" Foreground="{StaticResource FgMutedBrush}"
                   Text="Раздел появится следующим шагом." />
      </TabItem>
      <TabItem Header="УСТРОЙСТВА">
        <Grid RowDefinitions="*,Auto" Margin="10,8">
          <!-- Панель управления прижата к низу и получает место раньше списка:
               на экране 1024x600 иначе она уезжает за край. -->
          <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  CornerRadius="2" Background="{StaticResource BgPanelBrush}">
            <ListBox ItemsSource="{Binding Devices.Devices}"
                     SelectedItem="{Binding Devices.Selected}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceRow">
                  <Grid ColumnDefinitions="90,160,*,140,120" Height="30">
                    <TextBlock Grid.Column="0" Text="{Binding Display}"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource BrandBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Employee}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMainBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Department}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding LastSeen}"
                               FontFamily="DejaVu Sans Mono, Consolas, monospace"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding Label}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMutedBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Имя камеры" VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}" />
              <TextBox Text="{Binding Devices.NameInput}" Width="200" />
              <Button Content="Переименовать" Command="{Binding Devices.RenameCommand}" />
              <TextBlock Text="Сотрудник" VerticalAlignment="Center" Margin="12,0,0,0"
                         Foreground="{StaticResource FgMutedBrush}" />
              <ComboBox ItemsSource="{Binding Devices.Employees}"
                        SelectedItem="{Binding Devices.EmployeeInput}" Width="190">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:Employee">
                    <TextBlock Text="{Binding FullName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Закрепить" Command="{Binding Devices.AssignCommand}" />
              <Button Content="Обновить" Command="{Binding Devices.ReloadCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Devices.Hint}" FontSize="11"
                       Foreground="{StaticResource BrandBrush}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="НАСТРОЙКИ">
        <ScrollViewer>
          <Grid ColumnDefinitions="*,*" Margin="10,8">

            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,6,0">
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="2" Padding="10" Background="{StaticResource BgPanelBrush}">
                <StackPanel Spacing="6">
                  <TextBlock Text="ХРАНИЛИЩЕ" FontSize="11" LetterSpacing="1.6"
                             Foreground="{StaticResource BrandBrush}" />
                  <TextBlock Text="Папка для копий" FontSize="11"
                             Foreground="{StaticResource FgMutedBrush}" />
                  <TextBox Text="{Binding Settings.BackupRoot}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Оставлять свободными, ГБ" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}" />
                    <TextBox Text="{Binding Settings.MinFreeGb}" Width="70" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Когда место кончается" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}" />
                    <ComboBox ItemsSource="{Binding Settings.StorageModes}"
                              SelectedIndex="{Binding Settings.StorageModeIndex}" Width="190" />
                  </StackPanel>
                  <CheckBox Content="Удалять видео с камеры после загрузки"
                            IsChecked="{Binding Settings.DeleteVideoAfterCopy}" />
                  <Button Content="Сохранить" Command="{Binding Settings.SaveStorageCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="2" Padding="10" Background="{StaticResource BgPanelBrush}">
                <StackPanel Spacing="6">
                  <TextBlock Text="СОТРУДНИКИ И ОТДЕЛЫ" FontSize="11" LetterSpacing="1.6"
                             Foreground="{StaticResource BrandBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding Settings.DepartmentName}" Width="180"
                             Watermark="название отдела" />
                    <Button Content="Добавить отдел"
                            Command="{Binding Settings.AddDepartmentCommand}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding Settings.EmployeeName}" Width="150"
                             Watermark="фамилия и инициалы" />
                    <TextBox Text="{Binding Settings.EmployeeNo}" Width="80"
                             Watermark="номер" />
                    <ComboBox ItemsSource="{Binding Settings.Departments}"
                              SelectedItem="{Binding Settings.EmployeeDepartment}" Width="140">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:Department">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <Button Content="Добавить сотрудника"
                          Command="{Binding Settings.AddEmployeeCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8" Margin="6,0,0,0">
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="2" Padding="10" Background="{StaticResource BgPanelBrush}">
                <StackPanel Spacing="6">
                  <TextBlock Text="РАЗМЕТКА ГНЁЗД" FontSize="11" LetterSpacing="1.6"
                             Foreground="{StaticResource BrandBrush}" />
                  <TextBlock FontSize="11" TextWrapping="Wrap"
                             Foreground="{StaticResource FgMutedBrush}"
                             Text="Вставьте камеру в размечаемый отсек, оставив её единственной подключённой, и нажмите «Сопоставить» напротив нужного окна." />
                  <ItemsControl ItemsSource="{Binding Settings.Slots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SlotRow">
                        <Grid ColumnDefinitions="70,*,110" Height="26">
                          <TextBlock Grid.Column="0" Text="{Binding SlotLabel}" FontSize="11"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource FgMainBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding PortLabel}" FontSize="11"
                                     FontFamily="DejaVu Sans Mono, Consolas, monospace"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource FgMutedBrush}" />
                          <Button Grid.Column="2" Content="Сопоставить" FontSize="10"
                                  Padding="8,2"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MapSlotCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Снять разметку"
                          Command="{Binding Settings.ClearSlotsCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="2" Padding="10" Background="{StaticResource BgPanelBrush}">
                <StackPanel Spacing="4">
                  <TextBlock Text="О ПРОГРАММЕ" FontSize="11" LetterSpacing="1.6"
                             Foreground="{StaticResource BrandBrush}" />
                  <TextBlock Text="BestCam USB Backup Manager" FontSize="12"
                             Foreground="{StaticResource FgMainBrush}" />
                  <TextBlock Text="{Binding Version}" FontSize="11"
                             Foreground="{StaticResource FgMutedBrush}" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding Settings.Hint}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource BrandBrush}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Нижняя строка: слева марка, по центру заполнение хранилища, справа состояние -->
    <Grid Grid.Row="3" Background="{StaticResource BgPanelBrush}"
          ColumnDefinitions="Auto,*,Auto">
      <TextBlock Grid.Column="0" Text="© BestCam" Margin="12,0" FontSize="10"
                 VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding StorageLabel}" FontSize="10"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource FgMutedBrush}" />
        <Border Width="150" Height="6" CornerRadius="1"
                Background="{StaticResource BgSurfaceBrush}" ClipToBounds="True">
          <Border HorizontalAlignment="Left" Width="{Binding StorageWidth}"
                  Background="{Binding StorageBrush}">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.6" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.4" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Border>
      </StackPanel>

      <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="12,0" FontSize="10"
                 VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}"
                 />
    </Grid>
  </Grid>
</Window>
