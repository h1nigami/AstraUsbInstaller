<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Пластика прототипа: пилюли вместо прямоугольников, крупные скругления,
    мягкие тени, никаких резких границ. Размеры взяты из задания под палец:
    нажатие не меньше 44 точек, основные кнопки от 52.
  -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{StaticResource FgMainBrush}" />
  </Style>

  <!-- Заголовки экранов и состояний: единственный дисплейный шрифт системы -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LineHeight" Value="34" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="20" />
  </Style>

  <Style Selector="TextBlock.state">
    <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="19" />
  </Style>

  <!-- Микроподпись. Регистр поднимается в разметке: аналога text-transform нет -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.7" />
    <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
  </Style>

  <!-- Цифры моноширинными: номера и время не должны плясать при смене -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="DejaVu Sans Mono, Consolas, monospace" />
  </Style>

  <!-- Появление программы. Резкий скачок от пустого экрана к доске
       выглядит как сбой, поэтому окно проявляется. -->
  <Style Selector="Window">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Переходы цвета. Станция всё время что-то показывает состоянием:
       выбранный раздел, нажатую кнопку, поле под курсором, точку службы.
       Мгновенная перекраска читается как мигание, поэтому цвет везде
       приходит переходом. Ход короткий, около десятой доли секунды: на
       ощупь это «мягко», а не «медленно». -->
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TabItem">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Точка службы: сеть пропадает и возвращается сама, и цвет не должен
       переключаться щелчком. -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Пилюля состояния меняет и фон, и подпись. -->
  <Style Selector="Border.pill">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Смена раздела настроек. Подмена содержимого без перехода читается
       как подёргивание, особенно когда разделы разной высоты. -->
  <Style Selector=":is(Control).fade[IsVisible=true]">
    <Style.Animations>
      <Animation Duration="0:0:0.14" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Появление окон поверх доски. Мгновенная подмена экрана читается как
       рывок, поэтому подложка проявляется, а само окно чуть поднимается.
       Ход короткий: станция должна казаться быстрой, а не показывать
       анимацию. -->
  <Style Selector="Border.overlay[IsVisible=true]">
    <Style.Animations>
      <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.overlay[IsVisible=true] > Border">
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="TranslateTransform.Y" Value="14" />
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="TranslateTransform.Y" Value="0" />
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Отклик на касание. Палец закрывает место нажатия, и единственный
       признак, что станция услышала, это движение самой кнопки. Ход
       короткий: длиннее ста миллисекунд уже читается как задержка. -->
  <Style Selector="Button">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.09" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <!-- Прокрутка с продолжением движения: экран сенсорный, и список,
       встающий колом сразу после пальца, ощущается сломанным. -->
  <Style Selector="ScrollViewer">
    <Setter Property="IsScrollInertiaEnabled" Value="True" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True" />
  </Style>

  <!-- Кнопка по умолчанию: белая пилюля с волосяной рамкой -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
    <Setter Property="MinWidth" Value="{StaticResource TapMin}" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgMainBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Neutral200Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgMainBrush}" />
  </Style>

  <!-- Главное действие экрана -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgOnDarkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent600Brush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnDarkBrush}" />
  </Style>

  <!-- Необратимое действие: тёмный синий, а не красный. Красного в системе нет -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource Accent800Brush}" />
    <Setter Property="Foreground" Value="{StaticResource FgOnDarkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent900Brush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource FgOnDarkBrush}" />
  </Style>

  <!--
    Кнопка внутри строки списка. Основной размер в 52 точки рассчитан на палец
    и на отдельно стоящую кнопку; в строке таблицы такие кнопки наезжают друг
    на друга, поэтому здесь высота равна высоте строки.
  -->
  <Style Selector="Button.compact">
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="17" />
  </Style>

  <!-- Заголовок раздела настроек: он должен быть виден, а не угадываться -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource Accent700Brush}" />
  </Style>

  <!--
    Подпись поля. В макете она стоит над полем капсом, 12 точек, полужирная,
    с разрядкой: подпись слева от поля там не встречается ни разу.
  -->
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
  </Style>

  <!-- Поле формы по макету: высота 52 под палец, белый фон, крупный текст -->
  <Style Selector="TextBox.form">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="White" />
  </Style>

  <Style Selector="ComboBox.form">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="White" />
  </Style>

  <!-- Клавиша экранной клавиатуры -->
  <!-- Клавиша экранной клавиатуры: под палец, но так, чтобы полная
       раскладка уместилась в ширину экрана станции. -->
  <Style Selector="Button.key">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Width" Value="66" />
    <Setter Property="Height" Value="42" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{StaticResource BgAppBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="{StaticResource FieldHeight}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgMainBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource Accent300Brush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="MinHeight" Value="{StaticResource FieldHeight}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="{StaticResource FieldHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="MinHeight" Value="{StaticResource TapMin}" />
    <Setter Property="Foreground" Value="{StaticResource FgMainBrush}" />
  </Style>

  <!-- Панель: белая карточка с крупным скруглением и мягкой тенью -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="White" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="{StaticResource ShadowSm}" />
  </Style>

  <!-- Пункт бокового меню настроек -->
  <Style Selector="Button.nav">
    <Setter Property="Height" Value="{StaticResource TapMin}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Открытый подраздел. Правило идёт после nav, иначе тот перекрывает фон -->
  <Style Selector="Button.nav.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgOnDarkBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>

  <!-- Вкладки: пилюли вместо подчёркиваний -->
  <Style Selector="TabItem">
    <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="{StaticResource TapMin}" />
    <Setter Property="Height" Value="{StaticResource TapMin}" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgMainBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FgOnDarkBrush}" />
  </Style>

  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Наведение не должно гасить признак открытого раздела: экран
       сенсорный, курсор остаётся там, где последний раз коснулись, и
       открытый раздел выглядел закрытым. -->
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
  </Style>

  <Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="TabItem:selected:pointerover">
    <Setter Property="Foreground" Value="{StaticResource FgOnDarkBrush}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="{StaticResource TapMin}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent100Brush}" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Neutral200Brush}" />
  </Style>

</Styles>
